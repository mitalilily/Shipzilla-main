{
  "info": {
    "name": "Shiprocket API - Shipzilla Integration",
    "description": "Complete Shiprocket API endpoints integrated into Shipzilla. Base URL: {{base_url}}/api/shiprocket\n\nEnvironment Variables needed:\n- base_url: http://localhost:3000 (or your server URL)\n- token: JWT auth token from login\n- shiprocket_order_id: Order ID from Shiprocket\n- shiprocket_awb: AWB number\n- shiprocket_ndr_id: NDR ID\n- pickup_id: Pickup location ID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication & Serviceability",
      "item": [
        {
          "name": "Check Courier Serviceability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/shiprocket/courier/serviceability?delivery_postcode=110001&pickup_postcode=400001&cod=false&weight=500",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "shiprocket", "courier", "serviceability"],
              "query": [
                { "key": "delivery_postcode", "value": "110001" },
                { "key": "pickup_postcode", "value": "400001" },
                { "key": "cod", "value": "false" },
                { "key": "weight", "value": "500" }
              ]
            },
            "description": "Check if a pincode is serviceable by Shiprocket couriers"
          }
        },
        {
          "name": "Get Self Serviceability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/shiprocket/courier/serviceability/self?delivery_postcode=110001&pickup_postcode=400001",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "shiprocket", "courier", "serviceability", "self"],
              "query": [
                { "key": "delivery_postcode", "value": "110001" },
                { "key": "pickup_postcode", "value": "400001" }
              ]
            },
            "description": "Get self-serviceable pincodes"
          }
        },
        {
          "name": "Get Recommended Couriers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/shiprocket/courier/recommended?delivery_postcode=110001&pickup_postcode=400001&cod=false&weight=500",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "shiprocket", "courier", "recommended"],
              "query": [
                { "key": "delivery_postcode", "value": "110001" },
                { "key": "pickup_postcode", "value": "400001" },
                { "key": "cod", "value": "false" },
                { "key": "weight", "value": "500" }
              ]
            },
            "description": "Get recommended couriers for a shipment"
          }
        }
      ]
    },
